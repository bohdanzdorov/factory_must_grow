# Local development database from docker-compose.yml.
DATABASE_URL="postgresql://factory:factory_dev@localhost:5433/factorymustgrow"
NODE_ENV="development"
PORT=4000
LOG_LEVEL="info"
CLOCK_SCALE=60
# Real seconds an operator has to approve a proposal; Then converted to simulated time.
APPROVAL_WINDOW_SECONDS=120
# Shared secret for the machine heartbeat and event endpoints; simulators send the same value.
INGEST_TOKEN="dev-ingest-token-change-me"
