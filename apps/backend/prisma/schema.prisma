generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SiteStatus {
  UP
  DOWN

  @@map("site_status")
}

enum MachineStatus {
  IDLE
  RUNNING
  ERROR
  OFFLINE

  @@map("machine_status")
}

enum Capability {
  MILLING_3_AXIS
  MILLING_5_AXIS
  TURNING
  INSPECTION

  @@map("capability")
}

enum OrderStatus {
  DRAFT
  ROUTED
  APPROVED
  IN_PRODUCTION
  COMPLETE
  BLOCKED
  REROUTE_PENDING

  @@map("order_status")
}

enum JobStatus {
  PLANNED
  RUNNING
  COMPLETE
  RELEASED
  CANCELLED

  @@map("job_status")
}

enum RoutingDecisionKind {
  INITIAL
  REROUTE

  @@map("routing_decision_kind")
}

enum RoutingDecisionStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
  // Routing ran and found no machine: there is nothing to approve.
  NO_ELIGIBLE_MACHINE

  @@map("routing_decision_status")
}

enum CandidateRejectionReason {
  MISSING_CAPABILITY
  MACHINE_UNAVAILABLE
  SITE_DOWN
  MISSES_DEADLINE
  REJECTED_BY_OPERATOR

  @@map("candidate_rejection_reason")
}

enum MachineEventType {
  JOB_STARTED
  JOB_COMPLETED
  MACHINE_FAILURE

  @@map("machine_event_type")
}

enum CommandType {
  START_JOB
  FAIL
  RESET
  CANCEL_JOB

  @@map("command_type")
}

enum CommandStatus {
  PENDING
  DELIVERED
  ACKED
  CANCELLED

  @@map("command_status")
}

model Site {
  id      String     @id
  name    String
  country String
  status  SiteStatus @default(UP)

  machines          Machine[]
  shippingLeadTimes ShippingLeadTime[]

  @@map("site")
}

model Machine {
  id              String        @id
  siteId          String        @map("site_id")
  name            String
  status          MachineStatus @default(IDLE)
  lastHeartbeatAt DateTime?     @map("last_heartbeat_at") @db.Timestamptz(3)
  lastSeq         BigInt        @default(0) @map("last_seq")

  site              Site                @relation(fields: [siteId], references: [id])
  capabilities      MachineCapability[]
  jobs              Job[]
  routingDecisions  RoutingDecision[]
  routingCandidates RoutingCandidate[]
  events            MachineEvent[]
  commands          Command[]

  @@index([siteId])
  @@map("machine")
}

// One row per capability, because cycle time differs by machine and by process.
model MachineCapability {
  machineId           String     @map("machine_id")
  capability          Capability
  cycleMinutesPerPart Decimal    @map("cycle_minutes_per_part") @db.Decimal(8, 2)

  machine Machine @relation(fields: [machineId], references: [id])

  @@id([machineId, capability])
  @@map("machine_capability")
}

model Order {
  id                   String       @id @default(uuid())
  partName             String       @map("part_name")
  quantity             Int
  requiredCapabilities Capability[] @map("required_capabilities")
  deadline             DateTime     @db.Timestamptz(3)
  destination          String
  status               OrderStatus  @default(DRAFT)
  blockedReason        String?      @map("blocked_reason")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  routingDecisions RoutingDecision[]

  @@map("orders")
}

model Job {
  id                String    @id @default(uuid())
  routingDecisionId String    @map("routing_decision_id")
  machineId         String    @map("machine_id")
  status            JobStatus @default(PLANNED)
  plannedStart      DateTime  @map("planned_start") @db.Timestamptz(3)
  plannedEnd        DateTime  @map("planned_end") @db.Timestamptz(3)

  routingDecision RoutingDecision @relation(fields: [routingDecisionId], references: [id])
  machine         Machine         @relation(fields: [machineId], references: [id])

  @@index([routingDecisionId])
  @@index([machineId])
  @@map("job")
}

model RoutingDecision {
  id              String                @id @default(uuid())
  orderId         String                @map("order_id")
  // Null when no machine is eligible and the order becomes BLOCKED.
  chosenMachineId String?               @map("chosen_machine_id")
  explanation     String
  kind            RoutingDecisionKind
  status          RoutingDecisionStatus @default(PROPOSED)
  supersedesId    String?               @map("supersedes_id")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  order         Order              @relation(fields: [orderId], references: [id])
  chosenMachine Machine?           @relation(fields: [chosenMachineId], references: [id])
  supersedes    RoutingDecision?   @relation("DecisionSupersedes", fields: [supersedesId], references: [id])
  supersededBy  RoutingDecision[]  @relation("DecisionSupersedes")
  candidates    RoutingCandidate[]
  jobs          Job[]

  @@index([orderId])
  @@index([chosenMachineId])
  @@index([supersedesId])
  @@map("routing_decision")
}

// One row per machine considered. Values are a snapshot from when the decision was made.
model RoutingCandidate {
  routingDecisionId String                    @map("routing_decision_id")
  machineId         String                    @map("machine_id")
  // Position among viable machines, where 1 is the best. Null when rejected.
  rank              Int?
  rejectionReason   CandidateRejectionReason? @map("rejection_reason")
  earliestStart     DateTime?                 @map("earliest_start") @db.Timestamptz(3)
  finishAt          DateTime?                 @map("finish_at") @db.Timestamptz(3)
  slackMinutes      Decimal?                  @map("slack_minutes") @db.Decimal(12, 2)

  routingDecision RoutingDecision @relation(fields: [routingDecisionId], references: [id])
  machine         Machine         @relation(fields: [machineId], references: [id])

  @@id([routingDecisionId, machineId])
  @@index([machineId])
  @@map("routing_candidate")
}

model MachineEvent {
  id         String           @id @default(uuid())
  machineId  String           @map("machine_id")
  eventId    String           @map("event_id")
  seq        BigInt
  type       MachineEventType
  payload    Json
  receivedAt DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)

  machine Machine @relation(fields: [machineId], references: [id])

  @@unique([machineId, eventId])
  @@map("machine_event")
}

model Command {
  id        String        @id @default(uuid())
  machineId String        @map("machine_id")
  type      CommandType
  payload   Json
  status    CommandStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId, status])
  @@map("command")
}

model ShippingLeadTime {
  siteId      String @map("site_id")
  destination String
  days        Int

  site Site @relation(fields: [siteId], references: [id])

  @@id([siteId, destination])
  @@map("shipping_lead_time")
}
