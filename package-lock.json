{
  "name": "factorymustgrow",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "factorymustgrow",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/backend": {
      "name": "@factorymustgrow/backend",
      "version": "0.1.0",
      "dependencies": {
        "@factorymustgrow/shared": "*"
      }
    },
    "apps/frontend": {
      "name": "@factorymustgrow/frontend",
      "version": "0.1.0",
      "dependencies": {
        "@factorymustgrow/shared": "*"
      }
    },
    "apps/simulator": {
      "name": "@factorymustgrow/simulator",
      "version": "0.1.0",
      "dependencies": {
        "@factorymustgrow/shared": "*"
      }
    },
    "node_modules/@factorymustgrow/backend": {
      "resolved": "apps/backend",
      "link": true
    },
    "node_modules/@factorymustgrow/frontend": {
      "resolved": "apps/frontend",
      "link": true
    },
    "node_modules/@factorymustgrow/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@factorymustgrow/simulator": {
      "resolved": "apps/simulator",
      "link": true
    },
    "packages/shared": {
      "name": "@factorymustgrow/shared",
      "version": "0.1.0"
    }
  }
}
